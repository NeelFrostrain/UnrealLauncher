{
  "name": "unreal-launcher",
  "productName": "Unreal Launcher",
  "version": "2.6.1",
  "description": "A lightweight Electron desktop app for discovering, launching, and managing Unreal Engine installations and projects",
  "main": "./out/main/index.js",
  "author": "NeelFrostrain",
  "license": "PROPRIETARY SOURCE LICENSE",
  "homepage": "https://neelfrostrain.github.io/UnrealLauncher/",
  "download:win": "https://github.com/NeelFrostrain/UnrealLauncher/releases/download/v2.3.1/unreal-launcher-2.3.1-setup.exe",
  "download:linux": "https://github.com/NeelFrostrain/UnrealLauncher/releases/download/v2.3.1/unreal-launcher-2.3.1-linux.AppImage",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest",
    "test:run": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --mode development -- --no-sandbox",
    "dev:prod": "electron-vite dev --mode production",
    "build:native": "napi build --platform --release --manifest-path native/Cargo.toml && node ./scripts/copyNativeDist.js",
    "build:native:linux": "napi build --release --manifest-path native/Cargo.toml && node ./scripts/copyNativeDist.js",
    "build:native:mac": "napi build --release --manifest-path native/Cargo.toml && node ./scripts/copyNativeDist.js",
    "build:native:all": "node ./scripts/copyNativeDist.js",
    "build:tracer": "cargo build --release --manifest-path tracer/Cargo.toml",
    "build:tracer:debug": "cargo build --manifest-path tracer/Cargo.toml",
    "build:app": "electron-vite build",
    "build:fast": "electron-vite build",
    "build:package": "electron-builder --publish=never",
    "build": "cargo build --release --manifest-path tracer/Cargo.toml && electron-vite build && node ./scripts/copyTracer.js",
    "copy:tracer": "node ./scripts/copyTracer.js",
    "copy:tracer:linux": "node -e \"const fs=require('fs'),p=require('path'),src=p.join('tracer','target','release','unreal_launcher_tracer'),dst=p.join('resources','unreal_launcher_tracer');if(fs.existsSync(src))fs.copyFileSync(src,dst);else console.warn('tracer binary not found:',src)\"",
    "build:analyze": "electron-vite build && npx vite-bundle-analyzer out/renderer/assets/*.js",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:win": "cargo build --release --manifest-path tracer/Cargo.toml && electron-vite build && node ./scripts/copyTracer.js && electron-builder --win --publish=never",
    "build:mac": "electron-vite build && electron-builder --mac --publish=never",
    "build:linux": "cargo build --release --manifest-path tracer/Cargo.toml && electron-vite build && node ./scripts/copyTracer.js && electron-builder --linux --publish=never",
    "build:linux:unpack": "cargo build --release --manifest-path tracer/Cargo.toml && electron-vite build && node ./scripts/copyTracer.js && electron-builder --dir",
    "build:all": "cargo build --release --manifest-path tracer/Cargo.toml && electron-vite build && node ./scripts/copyTracer.js && electron-builder --win --mac --linux --publish=never",
    "clean": "rimraf out dist node_modules/.vite node_modules/.cache",
    "clean:build": "rimraf out dist"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.8.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@napi-rs/cli": "^3.6.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.1",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.8"
  }
}
