# Environment Configuration for UnrealLauncher
# Copy this file to .env and fill in your actual values

# App version — keep in sync with package.json "version"
VITE_APP_VERSION=0.0.0

# Discord webhook URL for feedback/bug reports
VITE_DISCORD_WEBHOOK_URL=

# Discord webhook URLs for system startup and feedback notifications
# These are compiled into the build and used in the main process
DISCORD_STARTUP_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Discord server invite link
VITE_DISCORD_INVITE_URL=https://discord.gg/vq4UDfevG2

# Discord Rich Presence application client ID
VITE_DISCORD_CLIENT_ID=

# GitHub repository base URL
VITE_GITHUB_REPO_URL=https://github.com/NeelFrostrain/UnrealLauncher

# Ko-fi donation link
VITE_KOFI_URL=https://ko-fi.com/NeelFrostrain

# Company / Studio Information
VITE_COMPANY_NAME=Cyronic Studio
VITE_COMPANY_WEBSITE_URL=https://cyronicstudio.vercel.app

# Creator & Author Information
VITE_CREATOR_NAME=Neel Frostrain
VITE_CREATOR_GITHUB_URL=https://github.com/NeelFrostrain
VITE_CREATOR_EMAIL=help.cyronicstudio@gmail.com

# Unified Legal, Terms & Privacy Policy Version
# Bumping this version (e.g. 1.0.0 -> 1.0.1) triggers the mandatory re-acceptance dialog for all users on startup
VITE_LEGAL_VERSION=1.0

